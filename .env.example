# Findrr Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# Never commit real credentials or secrets to git.

# Application Environment
FINDRR_ENV=development
FINDRR_LOG_LEVEL=INFO

# Storage & Data Paths
FINDRR_DATA_DIR=data/
FINDRR_MODELS_DIR=models/

# Search & Scraper Configuration
SELENIUM_HEADLESS=false
SELENIUM_BROWSER=chrome
SEARCH_RESULT_LIMIT=20
SEARCH_REQUEST_TIMEOUT_SECONDS=30

# Model Inference Configuration (Milestones 1-3 run on host CPU)
INFERENCE_DEVICE=cpu
MODEL_REGISTRY_PATH=docs/ml/model-registry.md
