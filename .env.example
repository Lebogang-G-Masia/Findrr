# Findrr Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# Never commit real credentials or secrets to git.
# Only variables listed here are read by Findrr. Real environment variables override .env.

# Storage paths
FINDRR_DB_PATH=data/findrr.db
FINDRR_MODELS_DIR=models/
FINDRR_DOCS_DIR=data/applications
FINDRR_CHROME_PROFILE_DIR=chrome_profile

# Inference (Milestones 1-3 run on the laptop CPU).
# true = use labelled MOCK runners even when verified artifacts exist (testing only).
FINDRR_MOCK_INFERENCE=false

# PROVISIONAL thresholds (BR-006) - not yet evaluated or approved.
FINDRR_RELEVANCE_THRESHOLD=0.70
FINDRR_DEDUP_THRESHOLD=0.88

# Search result bounds are NOT configured here: they are fixed at 2-10 per title by
# docs/spec/modules/04-find-postings.md and set per profile via `findrr config set`.
