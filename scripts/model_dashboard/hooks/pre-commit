#!/bin/sh
# Keeps scripts/model_dashboard/data/ in step with its sources (installed bundles, decision log,
# build.py). It rebuilds the data before each commit and adds any change to that commit.
# It never blocks a commit: without the virtual environment or the bundles it does nothing.
# Install once per clone: git config core.hooksPath scripts/model_dashboard/hooks
root=$(git rev-parse --show-toplevel) || exit 0
py="$root/.venv/bin/python"
[ -x "$py" ] || exit 0
[ -d "$root/models" ] || exit 0
[ -f "$root/scripts/model_dashboard/data/bench.json" ] || exit 0
if ! PYTHONPATH="$root/src" "$py" "$root/scripts/model_dashboard/build.py" >/dev/null 2>&1; then
  echo "model dashboard: build.py failed, data not rebuilt (the commit continues)" >&2
  exit 0
fi
if [ -n "$(git status --porcelain -- "$root/scripts/model_dashboard/data")" ]; then
  git add -- "$root/scripts/model_dashboard/data"
  echo "model dashboard: data rebuilt and added to this commit" >&2
fi
exit 0
